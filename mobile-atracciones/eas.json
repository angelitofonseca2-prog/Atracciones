{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-gateway-production-0afd.up.railway.app/api/v2",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://marketplace-gateway-production.up.railway.app/graphql",
        "EXPO_PUBLIC_USE_GRAPHQL": "true",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-gateway-production-0afd.up.railway.app/api/v2",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://marketplace-gateway-production.up.railway.app/graphql",
        "EXPO_PUBLIC_USE_GRAPHQL": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
