<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atracciones.MsIdentidad.Api</RootNamespace>
    <UserSecretsId>atracciones-ms-identidad</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\..\platform\shared\Contracts.Protos\usuario_service.proto" GrpcServices="Server" Link="Protos\usuario_service.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atracciones.MsIdentidad.Business\Atracciones.MsIdentidad.Business.csproj" />
    <ProjectReference Include="..\Atracciones.MsIdentidad.DataAccess\Atracciones.MsIdentidad.DataAccess.csproj" />
  </ItemGroup>

</Project>
