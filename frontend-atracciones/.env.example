# Copia este archivo a .env.local para desarrollo local
# cp .env.example .env.local

# URL de la API REST (sí va en el frontend; prefijo VITE_ obligatorio en Vite)
# Desarrollo local con API Gateway: `dotnet run` en platform/gateway suele usar :5000
# VITE_API_URL=http://localhost:5000/api/v1
# Si el gateway va con Docker Compose en Windows, usa :5050 (el 5000 a veces está reservado)
# VITE_API_URL=http://localhost:5050/api/v1
# Sin gateway (monolito directo): http://localhost:5031/api/v1
VITE_API_URL=https://microservicioatracionesapi-production.up.railway.app/api/v1

# Cliente PayPal (público) para el SDK en el navegador — sandbox o live según entorno
# VITE_PAYPAL_CLIENT_ID=

# --- PostgreSQL en Railway (referencia para el BACKEND, no para React)
# Las variables sin prefijo VITE_ no se exponen al navegador, pero este proyecto
# no usa la BD desde el frontend: configura la cadena en Microservicio.Atracciones.Api
# (appsettings.Development.json o dotnet user-secrets). No pongas credenciales en Git.
#
# DATABASE_PUBLIC_URL (Railway), ejemplo de forma:
# postgresql://postgres:<PASSWORD>@switchyard.proxy.rlwy.net:16978/railway
#
# Equivalente para ConnectionStrings:AtraccionesDb (Npgsql), misma instancia:
# Host=switchyard.proxy.rlwy.net;Port=16978;Database=railway;Username=postgres;Password=<PASSWORD>;SSL Mode=Require;Search Path=atracciones
