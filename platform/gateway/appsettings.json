      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": [],
  "Otlp": {
    "Endpoint": "",
    "ServiceName": "atracciones-gateway"
  },
  "ReverseProxy": {
