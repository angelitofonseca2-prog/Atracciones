        "Order": 4,
        "Match": { "Path": "/api/v1/admin/imagenes/{**catch-all}" }
      },
      "admin-categorias-root": {
        "ClusterId": "atracciones",
        "Order": 5,
        "Match": { "Path": "/api/v1/admin/categorias" }
